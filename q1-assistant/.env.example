# 服务
PORT=3000
DB_PATH=./data/app.db
CORPUS_DIR=./Q1-语料

# LLM（切换厂商只改这三行，复制本文件为 .env 后填写）
# DeepSeek:  https://api.deepseek.com/v1        + deepseek-chat
# 豆包方舟:   https://ark.cn-beijing.volces.com/api/v3 + 推理接入点 ID
# OpenAI:    https://api.openai.com/v1          + gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换我
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
# functionCalling（默认，兼容端点支持最好）| json
LLM_STRUCTURED_METHOD=functionCalling
